
{
  "expo": {
    "name": "FreshCart",
    "slug": "freshcart",
    "scheme": "freshcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5FAFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freshcart.app"
    },
    "android": {
      "package": "com.freshcart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FreshCart to select a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreshCart needs your location to identify your delivery address."
        }
      ]
    ]
  }
}
